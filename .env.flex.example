# Copy to .env.flex and keep it private.
FLEX_PORT=3100
FLEX_MEMORY_FILE=./data/flex-memory.json
FLEX_CORS_ORIGIN=http://localhost:3100

# Cheap provider for routine tasks (OpenRouter, OpenAI-compatible gateway, etc.)
FLEX_CHEAP_NAME=openrouter-cheap
FLEX_CHEAP_BASE_URL=https://openrouter.ai/api/v1
FLEX_CHEAP_MODEL=
FLEX_CHEAP_API_KEY=

# Primary provider for complex work
FLEX_PRIMARY_NAME=openrouter-primary
FLEX_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
FLEX_PRIMARY_MODEL=
FLEX_PRIMARY_API_KEY=

# Optional local OpenAI-compatible model (for example Ollama)
FLEX_LOCAL_NAME=ollama
FLEX_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
FLEX_LOCAL_MODEL=
FLEX_LOCAL_API_KEY=ollama

# Optional LATIF-CLOUD adapter; expected POST /memory
LATIF_CLOUD_URL=
LATIF_CLOUD_TOKEN=
